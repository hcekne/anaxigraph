{
  "schema_version": 1,
  "limits": {
    "implementation_warning": 400,
    "implementation_hard": 500,
    "test_warning": 400,
    "test_hard": 500,
    "asset_warning": 400,
    "asset_hard": 500
  },
  "implementation_extensions": [".py", ".js", ".jsx", ".mjs", ".ts", ".tsx"],
  "test_patterns": [
    "tests/**",
    "test/**",
    "**/tests/**",
    "**/*.test.*",
    "**/*.spec.*",
    "**/test_*.py",
    "**/*_test.py"
  ],
  "exclusions": [],
  "legacy_exceptions": []
}
